root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# These rules are checked by the build (EnforceCodeStyleInBuild in Directory.Build.props),
# and with TreatWarningsAsErrors a finding fails the build (ADR-0001).

# Formatting.
dotnet_diagnostic.IDE0055.severity = warning
# Unused usings.
dotnet_diagnostic.IDE0005.severity = warning
# File-scoped namespaces, not block-scoped.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
