<Project>
  <!--
    Referencias al juego y a MelonLoader, tomadas de la instalación local (ADR-0003).
    Ningún DLL de acá se copia a la salida (Private=false) ni entra al repo.

    La ruta del juego se pisa con la variable de entorno DISFIGURE_RUTA_JUEGO, o con
    -p:RutaJuego=... en la línea de comandos.
  -->
  <PropertyGroup>
    <RutaJuego Condition="'$(RutaJuego)' == '' and '$(DISFIGURE_RUTA_JUEGO)' != ''">$(DISFIGURE_RUTA_JUEGO)</RutaJuego>
    <RutaJuego Condition="'$(RutaJuego)' == ''">J:\SteamLibrary\steamapps\common\Disfigure</RutaJuego>
    <RutaJuego>$([MSBuild]::EnsureTrailingSlash('$(RutaJuego)'))</RutaJuego>
    <RutaMelonLoader>$(RutaJuego)MelonLoader\</RutaMelonLoader>
    <RutaIl2CppAssemblies>$(RutaMelonLoader)Il2CppAssemblies\</RutaIl2CppAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(RutaMelonLoader)net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(RutaMelonLoader)net6\0Harmony.dll" Private="false" />
    <Reference Include="$(RutaMelonLoader)net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(RutaMelonLoader)net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(RutaIl2CppAssemblies)*.dll" Private="false" />
  </ItemGroup>

  <!--
    Sin el juego, el build fallaría con errores de tipos que no existen y sin decir qué ruta
    buscó. Este chequeo corta antes y dice qué hacer.
  -->
  <Target Name="VerificarRutaJuego" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RutaIl2CppAssemblies)Assembly-CSharp.dll')"
           Text="No encontré el juego con MelonLoader: falta $(RutaIl2CppAssemblies)Assembly-CSharp.dll. Abrí Disfigure una vez con MelonLoader instalado para que lo genere, o apuntá la variable de entorno DISFIGURE_RUTA_JUEGO a la carpeta del juego." />
  </Target>

  <!--
    Con -p:Desplegar=true, el DLL del mod se copia a la carpeta Mods del juego. Sin esa
    propiedad, el build no toca la instalación del juego.
  -->
  <Target Name="Desplegar" AfterTargets="Build" Condition="'$(Desplegar)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RutaJuego)Mods\" />
    <Message Importance="high" Text="Desplegado: $(TargetFileName) -> $(RutaJuego)Mods\" />
  </Target>
</Project>
