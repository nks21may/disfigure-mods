<Project>
  <!-- Applies to every project in the repo. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Lint is part of the build: the analyzers and the .editorconfig style rules run at
      compile time and a finding is an error, so `dotnet build` never finishes with pending
      lint (ADR-0001).
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      IDE0005 (unused usings) is only reported in the build with XML documentation turned on.
      CS1591 (missing XML comment) is off: documenting every public member is not a rule of
      this repo.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!--
      BepInEx 6 IL2CPP loads plugins on .NET 6, which is out of support. Without this the SDK
      warns (NETSDK1138) and, with warnings as errors, the build fails.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
</Project>
